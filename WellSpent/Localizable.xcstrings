{
  "sourceLanguage": "en",
  "strings": {
    "%@ connected %lld bank(s) to %@, but their account isn't on a paid plan, so those transactions won't be imported. Bank sync is per person, so they'll need to upgrade.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connected %lld bank(s) to %@, but their account isn't on a paid plan, so those transactions won't be imported. Bank sync is per person, so they'll need to upgrade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ conectó %lld banco(s) a %@, pero su cuenta no tiene un plan pago, así que esas transacciones no se importarán. La sincronización bancaria es por persona, así que necesita mejorar su plan."
          }
        }
      }
    },
    "%@ has income attributed to them. Choose who to reassign it to before removing them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has income attributed to them. Choose who to reassign it to before removing them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiene ingresos asignados. Elige a quién reasignarlos antes de eliminarlo."
          }
        }
      }
    },
