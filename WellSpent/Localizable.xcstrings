          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás viendo un período pasado. Agregar, eliminar, marcar como pagado y excluir transacciones está deshabilitado — aún puedes cambiar la categoría de una transacción."
          }
        }
      }
